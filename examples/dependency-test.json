{
  "family": "dependency-test",
  "containerDefinitions": [
    {
      "name": "init",
      "image": "alpine:latest",
      "memory": 128,
      "cpu": 64,
      "essential": false,
      "command": ["sh", "-c", "echo 'Init container starting' && sleep 2 && echo 'Init complete'"]
    },
    {
      "name": "app",
      "image": "nginx:alpine",
      "memory": 256,
      "cpu": 128,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 9998,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "init",
          "condition": "COMPLETE"
        }
      ]
    }
  ]
}
