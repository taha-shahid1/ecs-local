{
  "family": "network-test",
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "server",
      "image": "nginx:alpine",
      "memory": 256,
      "cpu": 128,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 9999,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "client",
      "image": "alpine:latest",
      "memory": 128,
      "cpu": 64,
      "essential": false,
      "command": ["sh", "-c", "sleep 5 && wget -O- http://server:80 && sleep 300"],
      "environment": [
        {
          "name": "SERVER_HOST",
          "value": "server"
        }
      ]
    }
  ]
}
